# 业务数据库
DATABASE_URL=mysql+aiomysql://chat_user:your_password_here@localhost:3306/chat_rooms

# 入口门禁
CHAT_GATE_PASSWORD=drrr
# 单独执行 secrets.token_urlsafe(48) 生成门禁签名密钥，不得与 JWT 密钥相同。
CHAT_GATE_COOKIE_SECRET=

# JWT
# 再次独立执行 secrets.token_urlsafe(48) 生成 JWT 签名密钥，至少 32 个 UTF-8 字节。
CHAT_JWT_SECRET=
# 有效期范围为 60 到 604800 秒，非法配置会阻止启动。
CHAT_ACCESS_TOKEN_EXPIRE_SECONDS=3600

# GitHub Issues 代理
GITHUB_ISSUES_OWNER=Yiyan-Jiang
GITHUB_ISSUES_REPO=Drrr-chatRoom-add-AIChat
# 可选：需要时使用仅具有公开仓库读取权限的细粒度令牌。
GITHUB_TOKEN=
